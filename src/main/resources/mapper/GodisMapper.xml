<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.migration.metadata.MetaMapper">
    <resultMap id="migrationPropertyMap" type="com.migration.metadata.MigrationProperty">
        <result property="key" column="PROP_KEY"/>
        <result property="value" column="PROP_VALUE"/>
    </resultMap>

    <resultMap id="migrationTableInfoMap" type="com.migration.metadata.MigrationTableInfo">
        <result property="tableId" column="TABLE_ID"/>
        <result property="procOrd" column="PROC_ORD"/>
        <result property="taskId" column="TASK_ID"/>
        <result property="tableNm" column="TABLE_NM"/>
        <result property="migCond" column="MIG_COND"/>
        <result property="migMode" column="MIG_MODE"/>
        <result property="lobYn" column="LOB_YN"/>
        <result property="migModeRsn" column="MIG_MODE_RSN"/>
        <result property="parallelDgr" column="PARALLEL_DGR"/>
        <result property="mngrId" column="MNGR_ID"/>
        <result property="bizAreaCd" column="BIZ_AREA_CD"/>
        <result property="subjAreaCd" column="SUBJ_AREA_CD"/>
        <result property="grp1Cd" column="GRP1_CD"/>
        <result property="grp2Cd" column="GRP2_CD"/>
        <result property="grp3Cd" column="GRP3_CD"/>
        <result property="grp4Cd" column="GRP4_CD"/>
        <result property="grp5Cd" column="GRP5_CD"/>
        <result property="clnupTpCd" column="CLNUP_TP_CD"/>
        <result property="useYn" column="USE_YN"/>
        <result property="regId" column="REG_ID"/>
        <result property="regDtm" column="REG_DTM"/>
        <result property="lstAdjprnId" column="LST_ADJPRN_ID"/>
        <result property="lstAdjDtm" column="LST_ADJ_DTM"/>
        <collection property="validationTargets"
                    column="TABLE_ID"
                    select="selectValidationTargets"/>
    </resultMap>

    <resultMap id="validationTargetMap" type="com.migration.metadata.ValidationTarget">
        <result property="tableId" column="TABLE_ID"/>
        <result property="colId" column="COL_ID"/>
        <result property="colOrd" column="COL_ORD"/>
        <result property="tableNm" column="TABLE_NM"/>
        <result property="colNm" column="COL_NM"/>
        <result property="dataType" column="DATA_TYPE"/>
        <result property="pkYn" column="PK_YN" typeHandler="com.migration.metadata.YnBooleanTypeHandler"/>
        <result property="nullYn" column="NULL_YN" typeHandler="com.migration.metadata.YnBooleanTypeHandler"/>
        <result property="sumYn" column="SUM_YN" typeHandler="com.migration.metadata.YnBooleanTypeHandler"/>
        <result property="minYn" column="MIN_YN" typeHandler="com.migration.metadata.YnBooleanTypeHandler"/>
        <result property="maxYn" column="MAX_YN" typeHandler="com.migration.metadata.YnBooleanTypeHandler"/>
        <result property="avgYn" column="AVG_YN" typeHandler="com.migration.metadata.YnBooleanTypeHandler"/>
        <result property="hashYn" column="HASH_YN" typeHandler="com.migration.metadata.YnBooleanTypeHandler"/>
        <result property="byteLenYn" column="BYTE_LEN_YN" typeHandler="com.migration.metadata.YnBooleanTypeHandler"/>
        <result property="distCntYn" column="DIST_CNT_YN" typeHandler="com.migration.metadata.YnBooleanTypeHandler"/>
        <result property="nullCntYn" column="NULL_CNT_YN" typeHandler="com.migration.metadata.YnBooleanTypeHandler"/>
        <result property="regId" column="REG_ID"/>
        <result property="regDtm" column="REG_DTM"/>
        <result property="lstAdjprnId" column="LST_ADJPRN_ID"/>
        <result property="lstAdjDtm" column="LST_ADJ_DTM"/>
    </resultMap>

    <select id="selectMigrationTable" resultMap="migrationTableInfoMap">
        SELECT TABLE_ID, PROC_ORD, TASK_ID, TABLE_NM, MIG_COND
             , MIG_MODE, LOB_YN, MIG_MODE_RSN, PARALLEL_DGR, MNGR_ID
             , BIZ_AREA_CD, SUBJ_AREA_CD, GRP1_CD, GRP2_CD, GRP3_CD, GRP4_CD, GRP5_CD
             , CLNUP_TP_CD, USE_YN, REG_ID, REG_DTM, LST_ADJPRN_ID, LST_ADJ_DTM
          FROM GPCL_MIG_TABLE
         WHERE TASK_ID = #{taskId}
         ORDER BY TABLE_ID, PROC_ORD
    </select>

    <select id="selectMigrationProperties" resultMap="migrationPropertyMap">
        SELECT CD_VAL           AS PROP_KEY
             , CD_ADD_INFO_VAL1 AS PROP_VALUE
          FROM GPCL_CM_CD_VAL
         WHERE GRP_CD_ID = 'MIGRATION'
    </select>

    <select id="selectValidationTargets" resultMap="validationTargetMap">
        SELECT TABLE_ID, COL_ID, COL_ORD, TABLE_NM, COL_NM, DATA_TYPE
             , PK_YN, NULL_YN, SUM_YN, MIN_YN, MAX_YN, AVG_YN
             , HASH_YN, BYTE_LEN_YN, DIST_CNT_YN, NULL_CNT_YN
             , REG_ID, REG_DTM, LST_ADJPRN_ID, LST_ADJ_DTM
          FROM GPCL_MIG_VRF_TARGET
         WHERE TABLE_ID = #{tableId}
         ORDER BY TABLE_ID, COL_ORD
    </select>

    <insert id="upsertSourceValidationResults">
        INSERT INTO GPCL_MIG_VRF_RESULT (
            EXE_ORD, TABLE_ID, PROC_ORD, COL_ID, MNGR_ID,
            SRC_ROW_CNT, SRC_SUM_VAL, SRC_MIN_VAL, SRC_MAX_VAL, SRC_AVG_VAL,
            SRC_HASH_VAL, SRC_BYTE_LEN_VAL, SRC_DIST_CNT_VAL, SRC_NULL_CNT_VAL,
            VRF_STAT_CD, CONF_STAT_CD,
            REG_ID, REG_DTM, LST_ADJPRN_ID, LST_ADJ_DTM
        ) VALUES
        <foreach collection="results" item="result" separator=",">
            (
                #{execOrd}, #{tableId}, #{procOrd}, #{result.colId}, #{mngrId},
                #{result.rowCount}, #{result.sum}, #{result.min}, #{result.max}, #{result.avg},
                NULL, #{result.byteLength}, #{result.distinctCount}, #{result.nullCount},
                '30', '10', #{auditId}, NOW(), #{auditId}, NOW()
            )
        </foreach>
        ON DUPLICATE KEY UPDATE
            MNGR_ID = VALUES(MNGR_ID),
            SRC_ROW_CNT = VALUES(SRC_ROW_CNT),
            SRC_SUM_VAL = VALUES(SRC_SUM_VAL),
            SRC_MIN_VAL = VALUES(SRC_MIN_VAL),
            SRC_MAX_VAL = VALUES(SRC_MAX_VAL),
            SRC_AVG_VAL = VALUES(SRC_AVG_VAL),
            SRC_HASH_VAL = NULL,
            SRC_BYTE_LEN_VAL = VALUES(SRC_BYTE_LEN_VAL),
            SRC_DIST_CNT_VAL = VALUES(SRC_DIST_CNT_VAL),
            SRC_NULL_CNT_VAL = VALUES(SRC_NULL_CNT_VAL),
            VRF_STAT_CD = '30',
            CONF_STAT_CD = '10',
            CONF_DTM = NULL,
            LST_ADJPRN_ID = VALUES(LST_ADJPRN_ID),
            LST_ADJ_DTM = NOW()
    </insert>
</mapper>
