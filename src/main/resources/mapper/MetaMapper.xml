<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.migration.metadata.MetaMapper">
    <resultMap id="tableInfoMap" type="com.migration.metadata.TableInfo">
        <result property="tableSchema" column="TABLE_SCHEMA"/>
        <result property="tableName" column="TABLE_NAME"/>
        <result property="procOrd" column="PROC_ORD"/>
        <result property="tableComment" column="TABLE_COMMENT"/>
        <result property="jobId" column="JOB_ID"/>
        <result property="splitYn" column="SPLIT_YN"/>
        <result property="migCond" column="MIG_COND"/>
        <result property="mngrId" column="MNGR_ID"/>
    </resultMap>

    <resultMap id="validationTargetMap" type="com.migration.metadata.ValidationTarget">
        <result property="tableSchema" column="TABLE_SCHEMA"/>
        <result property="tableName" column="TABLE_NAME"/>
        <result property="columnName" column="COLUMN_NAME"/>
        <result property="ordinalPosition" column="ORDINAL_POSITION"/>
        <result property="dataType" column="DATA_TYPE"/>
        <result property="sumYn" column="SUM_YN" typeHandler="com.migration.metadata.YnBooleanTypeHandler"/>
        <result property="minYn" column="MIN_YN" typeHandler="com.migration.metadata.YnBooleanTypeHandler"/>
        <result property="maxYn" column="MAX_YN" typeHandler="com.migration.metadata.YnBooleanTypeHandler"/>
        <result property="avgYn" column="AVG_YN" typeHandler="com.migration.metadata.YnBooleanTypeHandler"/>
    </resultMap>

    <select id="selectMigrationTables" resultMap="tableInfoMap">
        SELECT TABLE_SCHEMA, TABLE_NAME, PROC_ORD, TABLE_COMMENT,
               JOB_ID, SPLIT_YN, MIG_COND, MNGR_ID
          FROM GPCL_MIG_TABLE
         WHERE JOB_ID = #{jobId}
         ORDER BY PROC_ORD, TABLE_SCHEMA, TABLE_NAME
    </select>

    <select id="selectValidationTargets" resultMap="validationTargetMap">
        SELECT TABLE_SCHEMA, TABLE_NAME, COLUMN_NAME, ORDINAL_POSITION,
               DATA_TYPE, SUM_YN, MIN_YN, MAX_YN, AVG_YN
          FROM GPCL_MIG_VRF_TARGET
         WHERE TABLE_SCHEMA = #{tableSchema}
           AND TABLE_NAME = #{tableName}
         ORDER BY ORDINAL_POSITION
    </select>
</mapper>
